# systemd user unit: cp to ~/.config/systemd/user/ and
#   systemctl --user daemon-reload && systemctl --user enable --now smalltv-companion
# Runs in your session so it can see the session bus (music, notifications).
[Unit]
Description=SmallTV companion (pushes the screen to the SmallTV)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/smalltv-companion run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
